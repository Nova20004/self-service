# Copy is generated for you by `gmake env` with real random values.
# Placeholders only - never put real secrets in this file.
ADMIN_TOKEN=replace-me-admin-token-placeholder
OWNER_TOKENS=alice:replace-me-alice-token-placeholder,bob:replace-me-bob-token-placeholder
SLACK_SIGNING_SECRET=replace-me-slack-signing-secret
API_PORT=8000
EDGE_PORT=8080
# Group owning /var/run/docker.sock: 0 on Docker Desktop, `docker` group id on Linux.
DOCKER_SOCKET_GID=0

# Optional overrides (defaults shown)
# BASE_DOMAIN=localhost
# MIN_TTL_SECONDS=60
# MAX_TTL_HOURS=48
# MAX_TOTAL_LIFETIME_HOURS=72
# MAX_ENVS_PER_OWNER=3
# MAX_ENVS_TOTAL=10
# MAX_TOTAL_MEMORY_MB=1024
# COST_PER_GB_HOUR=0.01
# RECONCILE_INTERVAL_SECONDS=3
# PROVISION_TIMEOUT_SECONDS=120
# ORPHAN_GRACE_SECONDS=60
